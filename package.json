{
  "name": "dsh-x-scroll",
  "version": "0.3.0",
  "description": "DSH 插件：每天刷一轮 X（Twitter）读帖写日报；点赞/关注/回复/发帖默认全关，需在设置里显式打开并受额度与台账约束",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib",
    "server",
    "prompts",
    "selfcheck.mjs",
    "README.md",
    "AGENTS.md",
    "LICENSE"
  ],
  "engines": {
    "dsh": ">=0.1.7-rc.1",
    "node": ">=22"
  },
  "dependencies": {
    "nodemailer": "^10.1.7"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Elohia/dsh-x-scroll.git"
  },
  "homepage": "https://github.com/Elohia/dsh-x-scroll#readme",
  "bugs": {
    "url": "https://github.com/Elohia/dsh-x-scroll/issues"
  },
  "license": "MIT",
  "author": "Elohia",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "twitter",
    "x",
    "mcp",
    "duty",
    "digest"
  ]
}
